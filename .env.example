# Azure DevOps (org kmmbynstech; KMM4 e KMM5 sao projetos separados dentro dela,
# ver lib/devops-projetos.ts para os nomes de projeto e Area Paths por produto)
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PAT=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# E-mail (Resend)
RESEND_API_KEY=
ALERTS_FROM_EMAIL=alertas@produto-hub.nstech.com.br

# Cron
CRON_SECRET=

# Login com Microsoft (Entra ID) — só ligue DEPOIS de configurar o provider Azure no Supabase
# (Authentication > Providers > Azure) e redeploy (variável NEXT_PUBLIC é embutida no build).
NEXT_PUBLIC_LOGIN_MICROSOFT=false
